{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LoanUploadPayload",
  "description": "Schema validation for the loan upload API payload",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "stringBoolean": {
      "type": "string",
      "enum": ["true", "false", "TRUE", "FALSE", "True", "False"]
    },
    "numericString": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d+)?$"
    },
    "integerString": {
      "type": "string",
      "pattern": "^-?\\d+$"
    },
    "dateString": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{1,2}-\\d{1,2}$"
    },
    "pincode": {
      "type": "string",
      "pattern": "^-?\\d{6}$"
    },
    "phoneNumber": {
      "type": "string",
      "pattern": "^\\d{10}$"
    },
    "emailString": {
      "type": "string",
      "format": "email"
    },
    "gender": {
      "type": "string",
      "enum": ["male", "female", "other", "Male", "Female", "Other"]
    },
    "applicantAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicant_address_text",
        "applicant_city",
        "applicant_state",
        "applicant_pincode",
        "applicant_address_type"
      ],
      "properties": {
        "applicant_address_text": { "type": "string", "minLength": 1 },
        "applicant_city": { "type": "string", "minLength": 1 },
        "applicant_state": { "type": "string", "minLength": 1 },
        "applicant_pincode": { "$ref": "#/definitions/pincode" },
        "applicant_landmark": { "type": "string" },
        "applicant_address_latitude": { "type": "string" },
        "applicant_address_longitude": { "type": "string" },
        "applicant_address_type": { "type": "string", "minLength": 1 }
      }
    },
    "applicantContact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicant_contact_number"],
      "properties": {
        "applicant_contact_number": { "$ref": "#/definitions/phoneNumber" }
      }
    },
    "applicantEmail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicant_email"],
      "properties": {
        "applicant_email": { "$ref": "#/definitions/emailString" }
      }
    },
    "coApplicantContact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["co_applicant_contact_number"],
      "properties": {
        "co_applicant_contact_number": { "$ref": "#/definitions/phoneNumber" },
        "co_applicant_contact_number_type": { "type": "string" },
        "co_applicant_contact_number_is_valid": { "$ref": "#/definitions/stringBoolean" },
        "co_applicant_contact_number_is_active": { "$ref": "#/definitions/stringBoolean" }
      }
    },
    "coApplicantEmail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["co_applicant_email"],
      "properties": {
        "co_applicant_email": { "$ref": "#/definitions/emailString" },
        "co_applicant_email_type": { "type": "string" },
        "co_applicant_email_is_valid": { "$ref": "#/definitions/stringBoolean" },
        "co_applicant_email_is_active": { "$ref": "#/definitions/stringBoolean" }
      }
    },
    "coApplicantAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "co_applicant_address_type",
        "co_applicant_address_text",
        "co_applicant_city",
        "co_applicant_state",
        "co_applicant_pincode"
      ],
      "properties": {
        "co_applicant_address_type": { "type": "string", "minLength": 1 },
        "co_applicant_address_text": { "type": "string", "minLength": 1 },
        "co_applicant_city": { "type": "string", "minLength": 1 },
        "co_applicant_state": { "type": "string", "minLength": 1 },
        "co_applicant_pincode": { "$ref": "#/definitions/pincode" },
        "co_applicant_address_latitude": { "type": "string" },
        "co_applicant_address_longitude": { "type": "string" }
      }
    },
    "coApplicant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "co_applicant_name",
        "co_applicant_gender",
        "co_applicant_dob",
        "co_applicant_contact_details",
        "co_applicant_address"
      ],
      "properties": {
        "co_applicant_name": { "type": "string", "minLength": 1 },
        "co_applicant_gender": { "$ref": "#/definitions/gender" },
        "co_applicant_dob": { "$ref": "#/definitions/dateString" },
        "co_applicant_language": { "type": "string" },
        "co_applicant_photo_link": { "type": "string" },
        "co_applicant_notice_reference_number": { "type": "string" },
        "co_applicant_type": { "type": "string" },
        "co_applicant_legal_heir": { "type": "string" },
        "co_applicant_prefix": { "type": "string" },
        "co_applicant_contact_details": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/coApplicantContact" }
        },
        "co_applicant_email_details": {
          "type": "array",
          "items": { "$ref": "#/definitions/coApplicantEmail" }
        },
        "co_applicant_address": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/coApplicantAddress" }
        }
      }
    },
    "defaultEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date_of_default", "total_outstanding_amount"],
      "properties": {
        "digital_communication_end_date": { "$ref": "#/definitions/dateString" },
        "advance_payment": { "$ref": "#/definitions/numericString" },
        "total_outstanding_amount": { "$ref": "#/definitions/numericString" },
        "allocation_month": { "$ref": "#/definitions/dateString" },
        "allocation_dpd_value": { "$ref": "#/definitions/integerString" },
        "settlement_amount": { "$ref": "#/definitions/numericString" },
        "expected_emi_principal_amount": { "$ref": "#/definitions/numericString" },
        "expected_emi_interest_amount": { "$ref": "#/definitions/numericString" },
        "expected_emi": { "$ref": "#/definitions/numericString" },
        "other_penalty": { "$ref": "#/definitions/numericString" },
        "client_amount_recovered": { "$ref": "#/definitions/numericString" },
        "date_of_default": { "$ref": "#/definitions/dateString" },
        "late_fee": { "$ref": "#/definitions/numericString" },
        "utilisation": { "$ref": "#/definitions/numericString" },
        "default_emi_number": { "$ref": "#/definitions/integerString" },
        "principal_outstanding_amount": { "$ref": "#/definitions/numericString" }
      }
    },
    "documentDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_number", "document_amount", "document_date"],
      "properties": {
        "document_number": { "type": "string", "minLength": 1 },
        "document_amount": { "$ref": "#/definitions/numericString" },
        "security_mode": { "type": "string" },
        "document_bank_name": { "type": "string" },
        "document_bank_ifsc_code": { "type": "string" },
        "document_date": { "$ref": "#/definitions/dateString" },
        "document_dishonour_date": { "$ref": "#/definitions/dateString" },
        "document_signature_name": { "type": "string" },
        "document_bounce_bank_account_number": { "type": "string" },
        "document_bounce_charges": { "$ref": "#/definitions/numericString" },
        "document_bounce_bank_name": { "type": "string" },
        "document_bounce_bank_ifsc_code": { "type": "string" },
        "document_bounce_bank_address": { "type": "string" },
        "document_bounce_memo_date": { "$ref": "#/definitions/dateString" },
        "reason_of_document_bounce": { "type": "string" },
        "document_micr": { "type": "string" },
        "document_presented_in_account": { "type": "string" },
        "document_presented_zone": { "type": "string" },
        "document_bounce_memo_branch_address": { "type": "string" },
        "document_signature_address_text": { "type": "string" },
        "document_signature_city": { "type": "string" },
        "document_signature_state": { "type": "string" },
        "document_signature_pincode": { "$ref": "#/definitions/pincode" },
        "document_sequence_number": { "type": "string" },
        "document_bounce_memo_reference_number": { "type": "string" },
        "document_bounce_memo_return_date": { "$ref": "#/definitions/dateString" },
        "document_umrn": { "type": "string" }
      }
    },
    "guarantorContact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loan_guarantor_contact_number"],
      "properties": {
        "loan_guarantor_contact_number": { "$ref": "#/definitions/phoneNumber" },
        "loan_guarantor_contact_type": { "type": "string" },
        "loan_guarantor_contact_number_is_valid": { "$ref": "#/definitions/stringBoolean" },
        "loan_guarantor_contact_number_is_active": { "$ref": "#/definitions/stringBoolean" }
      }
    },
    "guarantorEmail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loan_guarantor_email"],
      "properties": {
        "loan_guarantor_email": { "$ref": "#/definitions/emailString" },
        "loan_guarantor_email_type": { "type": "string" },
        "loan_guarantor_email_is_valid": { "$ref": "#/definitions/stringBoolean" },
        "loan_guarantor_email_is_active": { "$ref": "#/definitions/stringBoolean" }
      }
    },
    "guarantorAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loan_guarantor_address_type",
        "loan_guarantor_address_text",
        "loan_guarantor_city",
        "loan_guarantor_state",
        "loan_guarantor_pincode"
      ],
      "properties": {
        "loan_guarantor_address_type": { "type": "string", "minLength": 1 },
        "loan_guarantor_address_text": { "type": "string", "minLength": 1 },
        "loan_guarantor_city": { "type": "string", "minLength": 1 },
        "loan_guarantor_state": { "type": "string", "minLength": 1 },
        "loan_guarantor_pincode": { "$ref": "#/definitions/pincode" }
      }
    },
    "loanGuarantor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loan_guarantor_name", "loan_guarantor_contact_details"],
      "properties": {
        "loan_guarantor_name": { "type": "string", "minLength": 1 },
        "loan_guarantor_gender": { "$ref": "#/definitions/gender" },
        "loan_guarantor_legal_heir": { "type": "string" },
        "loan_guarantor_prefix": { "type": "string" },
        "loan_guarantor_contact_details": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/guarantorContact" }
        },
        "loan_guarantor_email_details": {
          "type": "array",
          "items": { "$ref": "#/definitions/guarantorEmail" }
        },
        "loan_guarantor_address": {
          "type": "array",
          "items": { "$ref": "#/definitions/guarantorAddress" }
        }
      }
    },
    "referenceContact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contact_number"],
      "properties": {
        "contact_number": { "$ref": "#/definitions/phoneNumber" },
        "reference_contact_number_type": { "type": "string" },
        "reference_contact_number_is_valid": { "$ref": "#/definitions/stringBoolean" },
        "reference_contact_number_is_active": { "$ref": "#/definitions/stringBoolean" }
      }
    },
    "referenceEmail": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "reference_email": { "$ref": "#/definitions/emailString" },
        "reference_email_type": { "type": "string" },
        "reference_email_is_valid": { "$ref": "#/definitions/stringBoolean" },
        "reference_email_is_active": { "$ref": "#/definitions/stringBoolean" }
      }
    },
    "referenceAddress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference_address_type": { "type": "string" },
        "reference_address_text": { "type": "string" },
        "reference_city": { "type": "string" },
        "reference_state": { "type": "string" },
        "reference_pincode": { "$ref": "#/definitions/pincode" }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reference_contact_details"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "reference_gender": { "$ref": "#/definitions/gender" },
        "reference_pan_number": { "type": "string" },
        "relation_with_applicant": { "type": "string" },
        "reference_contact_details": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/referenceContact" }
        },
        "reference_email_details": {
          "type": "array",
          "items": { "$ref": "#/definitions/referenceEmail" }
        },
        "reference_address": {
          "type": "array",
          "items": { "$ref": "#/definitions/referenceAddress" }
        }
      }
    }
  },
  "required": [
    "loan_id",
    "applicant_name",
    "applicant_dob",
    "applicant_contact_details",
    "applicant_address",
    "total_loan_amount",
    "emi_amount",
    "loan_tenure",
    "client_loan_sanction_date",
    "loan_end_date"
  ],
  "properties": {
    "loan_id": { "type": "string", "minLength": 1 },
    "client_customer_id": { "type": "string" },
    "group_id": { "type": "string" },
    "source": { "type": "string" },
    "tags": { "type": "string" },

    "applicant_prefix": { "type": "string" },
    "applicant_name": { "type": "string", "minLength": 1 },
    "applicant_dob": { "$ref": "#/definitions/dateString" },
    "applicant_gender": { "$ref": "#/definitions/gender" },
    "applicant_language": { "type": "string" },
    "applicant_legal_heir": { "type": "string" },
    "applicant_occupation": { "type": "string" },
    "applicant_monthly_income": { "$ref": "#/definitions/numericString" },
    "applicant_cibil_score": { "$ref": "#/definitions/numericString" },
    "applicant_aadhar_number": {
      "type": "string",
      "pattern": "^\\d{4}-?\\d{4}-?\\d{4}$"
    },
    "applicant_pan_number": { "type": "string", "minLength": 1 },
    "applicant_photo_link": { "type": "string" },
    "applicant_notice_reference_number": { "type": "string" },

    "applicant_address": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/applicantAddress" }
    },
    "applicant_contact_details": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/applicantContact" }
    },
    "applicant_email_details": {
      "type": "array",
      "items": { "$ref": "#/definitions/applicantEmail" }
    },

    "co_applicant": {
      "type": "array",
      "items": { "$ref": "#/definitions/coApplicant" }
    },

    "loan_guarantor": {
      "type": "array",
      "items": { "$ref": "#/definitions/loanGuarantor" }
    },

    "references": {
      "type": "array",
      "items": { "$ref": "#/definitions/reference" }
    },

    "total_loan_amount": { "$ref": "#/definitions/numericString" },
    "emi_amount": { "$ref": "#/definitions/numericString" },
    "interest_on_loan": { "$ref": "#/definitions/numericString" },
    "loan_tenure": { "$ref": "#/definitions/integerString" },
    "loan_foreclosure_amount": { "$ref": "#/definitions/numericString" },
    "client_loan_sanction_date": { "$ref": "#/definitions/dateString" },
    "loan_end_date": { "$ref": "#/definitions/dateString" },
    "loan_type": { "type": "string" },
    "loan_branch": { "type": "string" },
    "loan_region": { "type": "string" },
    "loan_zone": { "type": "string" },
    "loan_source_branch_address": { "type": "string" },
    "loan_nbfc_name": { "type": "string" },
    "loan_nbfc_cin": { "type": "string" },
    "loan_regional_manager_name": { "type": "string" },
    "loan_regional_manager_contact_number": { "$ref": "#/definitions/phoneNumber" },
    "loan_regional_manager_contact_email": { "$ref": "#/definitions/emailString" },

    "credit_account_holder_name": { "type": "string" },
    "credit_account_holder_type": { "type": "string" },
    "credit_account_number": { "type": "string" },
    "credit_bank_name": { "type": "string" },
    "credit_bank_ifsc_code": { "type": "string" },

    "backed_by_security": { "$ref": "#/definitions/stringBoolean" },
    "security_type": { "type": "string" },
    "tenure_finished": { "$ref": "#/definitions/stringBoolean" },
    "rbi_stage": { "type": "string" },

    "business_name": { "type": "string" },
    "center_name": { "type": "string" },
    "channel_partner": { "type": "string" },
    "merchant_name": { "type": "string" },
    "product_type": { "type": "string" },

    "vehicle_registration_number": { "type": "string" },
    "chassis_number": { "type": "string" },
    "engine_number": { "type": "string" },
    "make_and_model": { "type": "string" },

    "notice_date": { "$ref": "#/definitions/dateString" },
    "notice_delivery_partner": { "type": "string" },
    "receipt_number": { "type": "string" },

    "payment_link": { "type": "string" },
    "payment_link_expiry": { "$ref": "#/definitions/integerString" },
    "payment_mode": { "type": "string" },

    "defaults": {
      "type": "array",
      "items": { "$ref": "#/definitions/defaultEntry" }
    },
    "document_details": {
      "type": "array",
      "items": { "$ref": "#/definitions/documentDetail" }
    }
  }
}
