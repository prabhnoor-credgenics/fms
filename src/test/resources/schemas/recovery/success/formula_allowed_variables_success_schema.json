{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["message"],
  "properties": {
    "data": {
      "type": "array",
      "items": { "type": "string" }
    },
    "output": {
      "type": "array",
      "items": { "type": "string" }
    },
    "message": { "type": "string", "minLength": 1 },
    "success": { "type": "boolean" },
    "message_template": { "type": "string" },
    "message_placeholder": { "type": "object" }
  },
  "additionalProperties": true
}
