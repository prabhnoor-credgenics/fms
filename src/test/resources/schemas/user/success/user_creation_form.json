{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "data",
    "message"
  ],
  "properties": {
    "message": {
      "type": "string",
      "const": "variables fetched successfully"
    },
    "data": {
      "type": "object",
      "required": [
        "variables"
      ],
      "properties": {
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "active",
              "allow_multiple_values",
              "data_type",
              "is_default",
              "is_dropdown",
              "is_mandatory",
              "variable_category",
              "variable_id",
              "variable_name",
              "variable_type"
            ],
            "properties": {
              "active": {
                "type": "boolean"
              },
              "allow_multiple_values": {
                "type": "boolean"
              },
              "data_type": {
                "type": "string"
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "dropdown_values": {
                "type": [
                  "array",
                  "null"
                ]
              },
              "is_default": {
                "type": "boolean"
              },
              "is_dropdown": {
                "type": "boolean"
              },
              "is_mandatory": {
                "type": "boolean"
              },
              "variable_category": {
                "type": "string",
                "enum": [
                  "standard",
                  "additional"
                ]
              },
              "variable_id": {
                "type": "string"
              },
              "variable_name": {
                "type": "string"
              },
              "variable_type": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}