{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data Upload Mapping — PATCH Update Success Response",
  "type": "object",
  "required": ["success", "message", "data", "error", "message_template", "message_placeholder"],
  "properties": {
    "success": {
      "type": "boolean",
      "enum": [true]
    },
    "message": {
      "type": "string",
      "enum": ["Data upload mapping updated"]
    },
    "data": {
      "type": ["null", "object", "string"]
    },
    "error": {
      "type": ["null", "object"]
    },
    "message_template": {
      "type": "string"
    },
    "message_placeholder": {
      "type": ["null", "object"]
    }
  },
  "additionalProperties": false
}
