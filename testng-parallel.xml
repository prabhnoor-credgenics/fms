<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Parallel suite: each Cucumber scenario runs as a separate TestNG method.
  Tune thread-count to match CPU cores and API rate limits.
  Run: mvn test -Pparallel
-->
<!-- thread-count should match parallel.user.pool.size (default 3); increase both together -->
<suite name="API Test Suite (Parallel)" parallel="methods" thread-count="2" data-provider-thread-count="2">
    <test name="API Tests Parallel">
        <classes>
            <class name="runners.ParallelTestRunner"/>
        </classes>
    </test>
</suite>
