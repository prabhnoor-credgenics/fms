{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExportPaymentsErrorResponse",
  "description": "Failure envelope for POST {BASE_ROUTE}/export/payments (empty body / bad enum / bad date).",
  "type": "object",
  "required": ["message"],
  "properties": {
    "message": { "type": "string" },
    "success": { "type": ["boolean", "null"] },
    "data": { "type": ["array", "object", "null"] },
    "message_template": { "type": ["string", "null"] },
    "message_placeholder": { "type": ["object", "null"] }
  },
  "additionalProperties": true
}
