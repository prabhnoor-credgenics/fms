{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreditlineGlobalStatusListSuccessResponse",
  "description": "200 envelope for GET /recovery/global-status for a credit-line company (\"All Global Dispositions Fetched\"). Same shape as the lending list but the credit-line items do NOT carry a `priority` field, so it is optional here.",
  "type": "object",
  "required": [
    "data",
    "message",
    "success",
    "message_template",
    "message_placeholder"
  ],
  "properties": {
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "global_status_id",
          "company_id",
          "global_status_name",
          "global_status_key",
          "active",
          "is_default",
          "is_deleted"
        ],
        "properties": {
          "global_status_id": { "type": "integer" },
          "company_id": { "type": "string", "minLength": 1 },
          "global_status_name": { "type": "string", "minLength": 1 },
          "global_status_key": { "type": "string", "minLength": 1 },
          "active": { "type": "boolean" },
          "is_default": { "type": "boolean" },
          "is_deleted": { "type": "boolean" },
          "priority": { "type": ["integer", "null"] }
        },
        "additionalProperties": true
      }
    },
    "message": { "type": "string", "minLength": 1 },
    "success": { "type": "boolean" },
    "message_template": { "type": ["string", "null"] },
    "message_placeholder": { "type": ["object", "null"] }
  },
  "additionalProperties": true
}
