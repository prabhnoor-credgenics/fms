{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data Operations v2 (queue) Success Response — HTTP 202",
  "type": "object",
  "required": ["success", "message", "output", "error", "message_template", "message_placeholder"],
  "properties": {
    "success": {
      "type": "boolean",
      "enum": [true]
    },
    "message": {
      "type": "string"
    },
    "output": {
      "type": "string",
      "description": "Human-readable task-initiated message"
    },
    "error": {
      "type": ["null", "object", "string"]
    },
    "message_template": {
      "type": "string"
    },
    "message_placeholder": {
      "type": ["null", "object"]
    }
  },
  "additionalProperties": false
}
