          "type": "boolean"
        },
        "is_legal_enabled": {
          "type": "boolean"
        },
        "is_sub_disposition_required": {
          "type": "boolean"
        },
        "is_deleted": {
          "type": "boolean"
        },
        "sentiment": {
          "type": "string"
        },
        "is_chatr_enabled": {
          "type": "boolean"
        },
        "is_repossession_requests_enabled": {
          "type": "boolean"
        },
        "is_voicebot_enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  }
}