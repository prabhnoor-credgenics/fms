{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExportPaymentsDataSuccessResponse",
  "description": "200 data-mode / no-data response for POST {BASE_ROUTE}/export/payments: {\"data\":[...],\"message\":\"success|no data found\"}.",
  "type": "object",
  "required": ["data", "message"],
  "properties": {
    "data": { "type": "array" },
    "message": { "type": "string" },
    "success": { "type": ["boolean", "null"] },
    "message_template": { "type": ["string", "null"] },
    "message_placeholder": { "type": ["object", "null"] }
  },
  "additionalProperties": true
}
