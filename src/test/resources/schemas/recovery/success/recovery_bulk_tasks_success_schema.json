{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecoveryBulkTasksSuccessSchema",
  "type": "object",
  "required": [
    "success",
    "output",
    "message",
    "message_template",
    "message_placeholder"
  ],
  "properties": {
    "success": {
      "type": "boolean"
    },
    "output": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "status",
          "total_count",
          "success_count",
          "failure_count",
          "data_link",
          "data_key",
          "error_logs_link",
          "error_logs_key",
          "processing_started_at",
          "updated",
          "created",
          "created_by",
          "request_id",
          "operation_type",
          "total_tasks",
          "batch_name",
          "batch_description",
          "task_type",
          "is_export_link",
          "time_taken"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "total_count": {
            "type": "integer"
          },
          "success_count": {
            "type": "integer"
          },
          "failure_count": {
            "type": "integer"
          },
          "data_link": {
            "type": "string",
            "format": "uri"
          },
          "data_key": {
            "type": "string"
          },
          "error_logs_link": {
            "type": ["string", "null"]
          },
          "error_logs_key": {
            "type": ["string", "null"]
          },
          "processing_started_at": {
            "type": "string"
          },
          "updated": {
            "type": "string"
          },
          "created": {
            "type": "string"
          },
          "created_by": {
            "type": "object",
            "required": [
              "full_name",
              "username",
              "user_id"
            ],
            "properties": {
              "full_name": {
                "type": "string"
              },
              "username": {
                "type": "string",
                "format": "email"
              },
              "user_id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "operation_type": {
            "type": "string"
          },
          "total_tasks": {
            "type": "integer"
          },
          "batch_name": {
            "type": ["string", "null"]
          },
          "batch_description": {
            "type": ["string", "null"]
          },
          "task_type": {
            "type": "string"
          },
          "is_export_link": {
            "type": "boolean"
          },
          "time_taken": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      }
    },
    "message": {
      "type": "string",
      "enum": ["success"]
    },
    "message_template": {
      "type": "string",
      "enum": ["success"]
    },
    "message_placeholder": {
      "type": "object",
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
