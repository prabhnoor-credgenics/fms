{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompanyUsersListSuccessResponse",
  "description": "Success envelope for GET /user/company/users/ (list branch).",
  "type": "object",
  "required": ["data", "message"],
  "properties": {
    "data": {
      "type": "object",
      "required": ["users"],
      "properties": {
        "total_count": { "type": ["integer", "string", "null"] },
        "users": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        }
      },
      "additionalProperties": true
    },
    "message": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
