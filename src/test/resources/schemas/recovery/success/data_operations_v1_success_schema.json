{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data Operations v1 (real-time) Success Response — HTTP 200",
  "type": "object",
  "required": ["success", "message", "output", "error", "message_template", "message_placeholder"],
  "properties": {
    "success": {
      "type": "boolean",
      "enum": [true]
    },
    "message": {
      "type": "string"
    },
    "output": {
      "type": "object",
      "required": ["action_type", "category"],
      "properties": {
        "action_type": { "type": "string" },
        "category":    { "type": "string" }
      },
      "additionalProperties": false
    },
    "error": {
      "type": ["null", "object", "string"]
    },
    "message_template": {
      "type": "string"
    },
    "message_placeholder": {
      "type": ["null", "object"]
    }
  },
  "additionalProperties": false
}
