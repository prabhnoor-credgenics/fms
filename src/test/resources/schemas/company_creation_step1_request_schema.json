{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["validation_step", "data"],
  "properties": {
    "validation_step": {
      "type": "integer",
      "enum": [1]
    },
    "data": {
      "type": "object",
      "required": [
        "company_name",
        "trademark",
        "company_email",
        "company_type",
        "company_code",
        "gst_number",
        "country_isd_code",
        "calling_dialer_server",
        "calling_mode",
        "is_uat_company",
        "is_test_company",
        "is_purging_enabled",
        "authorized_representative_name",
        "authorized_representative_email"
      ],
      "properties": {
        "company_name": { "type": "string", "minLength": 1 },
        "trademark": { "type": "string", "minLength": 1 },
        "company_email": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "company_type": { "type": "string", "minLength": 1 },
        "company_code": { "type": "string", "minLength": 1 },
        "gst_number": { "type": "string", "minLength": 1 },
        "country_isd_code": { "type": "string", "minLength": 1 },
        "calling_dialer_server": { "type": "string", "minLength": 1 },
        "calling_mode": { "type": "string", "minLength": 1 },
        "is_uat_company": { "type": "boolean" },
        "is_test_company": { "type": "boolean" },
        "is_purging_enabled": { "type": "boolean" },
        "authorized_representative_name": { "type": "string", "minLength": 1 },
        "authorized_representative_email": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
