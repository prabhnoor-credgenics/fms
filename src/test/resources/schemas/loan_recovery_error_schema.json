{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "anyOf": [
    {
      "description": "Structured error at root (legacy / some endpoints)",
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "message_template": {
          "type": [
            "string",
            "null"
          ]
        },
        "message_placeholder": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    {
      "description": "Message-only errors (e.g. 401 session, 403 insufficient rights)",
      "required": ["message"],
      "properties": {
        "message": {
          "type": "string"
        }
      }
    },
    {
      "description": "Envelope with output.error (e.g. validation failures)",
      "required": ["output"],
      "properties": {
        "success": {
          "type": "boolean"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {},
        "message_template": {
          "type": [
            "string",
            "null"
          ]
        },
        "message_placeholder": {
          "type": [
            "object",
            "null"
          ]
        },
        "output": {
          "type": "object",
          "properties": {
            "error": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
