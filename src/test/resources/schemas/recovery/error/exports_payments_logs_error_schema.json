{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExportsPaymentsLogsErrorResponse",
  "description": "Failure envelope for GET {BASE_ROUTE}/exports/payments (mandatory/invalid export_category, page-size cap, bad request_id).",
  "type": "object",
  "required": ["message"],
  "properties": {
    "message": { "type": "string" },
    "success": { "type": ["boolean", "null"] },
    "data": { "type": ["object", "array", "null"] },
    "message_template": { "type": ["string", "null"] },
    "message_placeholder": { "type": ["object", "null"] }
  },
  "additionalProperties": true
}
