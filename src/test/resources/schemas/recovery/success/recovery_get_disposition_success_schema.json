{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DispositionsResponse",
  "type": "object",
  "required": ["data"],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/disposition"
      }
    }
  },
  "$defs": {
    "disposition": {
      "type": "object",
