<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Parallel suite: each feature file runs on a dedicated thread; scenarios within
  a feature run sequentially on that same thread.
  To change parallelism: edit data-provider-thread-count only.
  Run: mvn test -Pparallel
-->
<suite name="API Test Suite (Parallel)" data-provider-thread-count="50">
    <test name="API Tests Parallel">
        <classes>
            <class name="runners.ParallelTestRunner"/>
        </classes>
    </test>
</suite>
